{
  "manifest_version": 3,
  "name": "Prime Partners | Xero Reports",
  "version": "1.2.0",
  "description": "Prime Partners internal tool: download all Xero reports for the client you have open.",
  "minimum_chrome_version": "102",

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "permissions": ["tabs", "scripting", "downloads", "storage"],
  "host_permissions": [
    "https://reporting.xero.com/*",
    "https://go.xero.com/*"
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "Prime Partners | Xero Reports",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
